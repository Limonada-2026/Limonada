@layer utilities {
    .rich-text {
        @apply flex flex-col gap-6 md:gap-8 leading-relaxed;

        b,
        strong {
            @apply font-semibold;
        }

        a:not([class]) {
            @apply relative inline-flex overflow-hidden w-fit;

            &:before {
                @apply content-[''] absolute bottom-0 left-0 w-full h-px bg-current;
            }
    
            &:after {
                @apply content-[''] absolute z-2 bottom-0 left-0 w-full h-px bg-white -translate-x-full duration-600 transition-transform;
            }
    
            &:hover,
            &:focus-visible {
                &:after {
                    @apply translate-x-full;
                }
            }
        }

        ul {
            @apply relative pl-1;
    
            li {
                @apply block relative pl-4 mb-1;
    
                &:before {
                    @apply content-[''] w-1 min-w-1 h-1 bg-current absolute left-0 top-3.5;
                }
            }
        }

        ol {
            @apply relative pl-1 list-decimal;
            counter-reset: section;

            li {
                @apply block relative pl-4 mb-1;

                &:before {
                    @apply content-[counter(section)] absolute left-0 top-1 font-heading text-[.75em];
                    counter-increment: section;
                }
            }
        }

        p {
            @apply leading-relaxed;
        }
    
        h1 {
            @apply text-2xl md:text-3xl xl:text-4xl font-semibold;
        }

        h2 {
            @apply text-xl md:text-2xl xl:text-3xl font-semibold;
        }

        h3,
        h4,
        h5,
        h6 {
            @apply text-lg md:text-xl xl:text-2xl font-semibold;
        }
    
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            @apply text-green-medium;

            &:not(:first-child) {
                @apply mt-10;
            }
        }
    }
}